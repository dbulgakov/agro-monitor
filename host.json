{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "default": "Information",
      "Function": "Information",
      "Host.Results": "Information",
      "Host.Aggregator": "Warning" 
    }
  },
  "extensions": {
    "queues": {
      "maxPollingInterval": "00:00:02", 
      "visibilityTimeout": "00:05:00", 
      "batchSize": 1, 
      "maxDequeueCount": 5, 
      "newBatchThreshold": 0 
    }
  },
  "functionTimeout": "00:10:00" 
} 