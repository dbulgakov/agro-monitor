# Azure Storage Configuration (Used by azure_storage.py with DefaultAzureCredential)
# Ensure you are logged in via `az login` locally.
AZURE_STORAGE_ACCOUNT_NAME="<your_azure_storage_account_name>"

# Application Specific Storage Names
ANALYSIS_QUEUE_NAME="analysis-requests"
REPORTS_CONTAINER_NAME="reports"
PROGRESS_CONTAINER_NAME="job-status"
# IMAGES_CONTAINER_NAME="images" # Uncomment if used

# External Services (Example: OpenAI, STAC)
# OPENAI_API_KEY="<Your_OpenAI_API_Key>"
# OPENAI_ENDPOINT="<Optional_Azure_OpenAI_Endpoint>"
# OPENAI_API_VERSION="2023-05-15"
# OPENAI_MODEL="gpt-4o"
# STAC_API_URL="https://planetarycomputer.microsoft.com/api/stac/v1"

# CORS Settings for local FastAPI development (if needed)
# Adjust based on your frontend's local URL
# CORS_ALLOWED_ORIGINS="http://localhost:3000"
# CORS_SUPPORT_CREDENTIALS="true"

# Optional: Logging/Debug
# PYTHONASYNCIODEBUG="1" 