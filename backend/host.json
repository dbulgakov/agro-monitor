{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Function.process_analysis_job": "Error"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 5
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[3.*, 4.0.0)"
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "queues": {
      "maxPollingInterval": "00:00:02",
      "batchSize": 1,
      "newBatchThreshold": 1,
      "maxDequeueCount": 5,
      "messageEncoding": "none"
    }
  }
}
